@model ClusterFormViewModel
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo expediente" : $"Expediente {Model.Codigo}";
    var tipos = Html.GetEnumSelectList<TipoDenunciado>();
}

<h1 class="h3 mb-3">@(esNuevo ? "Nuevo expediente delictivo" : $"Expediente {Model.Codigo}")</h1>

<form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@(esNuevo ? null : Model.Id)" method="post">
    
    <button type="submit" name="accion" value="guardar" class="visually-hidden" tabindex="-1" aria-hidden="true">Guardar</button>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Codigo" />

    
    <div class="card mb-4">
        <div class="card-header fw-bold">A) Cabecera del expediente (maestro)</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Código del expediente</label>
                    <input class="form-control" value="@Model.Codigo" readonly />
                </div>
                <div class="col-md-8">
                    <label asp-for="NombreRed" class="form-label"></label>
                    <input asp-for="NombreRed" class="form-control" />
                    <span asp-validation-for="NombreRed" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistritoId" class="form-label"></label>
                    <select asp-for="DistritoId" asp-items="Model.Distritos" class="form-select"></select>
                    <span asp-validation-for="DistritoId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="RubroId" class="form-label"></label>
                    <select asp-for="RubroId" asp-items="Model.Rubros" class="form-select"></select>
                    <span asp-validation-for="RubroId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Severidad" class="form-label"></label>
                    <select asp-for="Severidad" asp-items="Html.GetEnumSelectList<NivelSeveridad>()" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoExpediente>()" class="form-select"></select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="FiscalAsignado" class="form-label"></label>
                    <input asp-for="FiscalAsignado" class="form-control" />
                    <span asp-validation-for="FiscalAsignado" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">B) Denunciados vinculados (detalle 1:N)</span>
            <button type="submit" name="accion" value="agregarDenunciado" formnovalidate class="btn btn-sm btn-success">+ Agregar denunciado al expediente</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Tipo</th><th>Número / cuenta</th><th>Titular</th><th class="text-center">Riesgo</th><th>Inclusión</th><th class="text-center">Acción</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Denunciados.Count; i++)
                    {
                        var d = Model.Denunciados[i];
                        <tr class="@(d.Eliminar ? "detalle-fila-eliminar" : "")">
                            <td>
                                <input type="hidden" asp-for="Denunciados[i].Id" />
                                <input type="hidden" asp-for="Denunciados[i].Puntaje" />
                                <input type="hidden" asp-for="Denunciados[i].FechaInclusion" />
                                @if (d.Id == 0)
                                {
                                    <select asp-for="Denunciados[i].Tipo" asp-items="tipos" class="form-select form-select-sm"></select>
                                }
                                else
                                {
                                    <input type="hidden" asp-for="Denunciados[i].Tipo" />
                                    @d.Tipo.NombreVisible()
                                }
                            </td>
                            <td>
                                @if (d.Id == 0)
                                {
                                    <input asp-for="Denunciados[i].Valor" class="form-control form-control-sm" />
                                    <span asp-validation-for="Denunciados[i].Valor" class="text-danger small"></span>
                                }
                                else
                                {
                                    <input type="hidden" asp-for="Denunciados[i].Valor" />
                                    <strong>@d.Valor</strong>
                                    <span asp-validation-for="Denunciados[i].Valor" class="text-danger small"></span>
                                }
                            </td>
                            <td>
                                <input asp-for="Denunciados[i].Titular" class="form-control form-control-sm" />
                                <span asp-validation-for="Denunciados[i].Titular" class="text-danger small"></span>
                            </td>
                            <td class="text-center">
                                @if (d.Id > 0)
                                {
                                    var color = d.Puntaje >= 70 ? "danger" : d.Puntaje >= 40 ? "warning text-dark" : "success";
                                    <span class="badge bg-@color">@d.Puntaje</span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td>@(d.FechaInclusion?.ToString("dd/MM/yyyy") ?? "Nuevo")</td>
                            <td class="text-center">
                                @if (d.Id == 0)
                                {
                                    <button type="submit" name="accion" value="quitarDenunciado:@i" formnovalidate class="btn btn-sm btn-outline-secondary">Quitar</button>
                                }
                                else
                                {
                                    <div class="form-check d-inline-block">
                                        <input asp-for="Denunciados[i].Eliminar" class="form-check-input" />
                                        <label asp-for="Denunciados[i].Eliminar" class="form-check-label small">Desvincular</label>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Denunciados.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted">Sin denunciados. Use el botón “Agregar denunciado”.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    
    <div class="card mb-4">
        <div class="card-header fw-bold">C) Reportes ciudadanos y evidencias asociadas (detalle 1:N)</div>
        <div class="card-body border-bottom">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label asp-for="CodigoReporteNuevo" class="form-label"></label>
                    <input asp-for="CodigoReporteNuevo" class="form-control" placeholder="REP-20260901-0001" />
                </div>
                <div class="col-auto">
                    <button type="submit" name="accion" value="agregarReporte" formnovalidate class="btn btn-success">+ Asociar reporte existente</button>
                </div>
            </div>
            @if (ViewBag.ErrorReporte != null)
            {
                <div class="text-danger small mt-2">@ViewBag.ErrorReporte</div>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Código</th><th>Fecha</th><th>Mensaje amenazante</th><th class="text-end">Monto (S/)</th><th class="text-center">Evidencias</th><th class="text-center">Acción</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Reportes.Count; i++)
                    {
                        var r = Model.Reportes[i];
                        <tr class="@(r.Eliminar ? "detalle-fila-eliminar" : "")">
                            <td>
                                <input type="hidden" asp-for="Reportes[i].ReporteId" />
                                <input type="hidden" asp-for="Reportes[i].Codigo" />
                                <input type="hidden" asp-for="Reportes[i].Fecha" />
                                <input type="hidden" asp-for="Reportes[i].Mensaje" />
                                <input type="hidden" asp-for="Reportes[i].Monto" />
                                <input type="hidden" asp-for="Reportes[i].Evidencias" />
                                <strong>@r.Codigo</strong>
                            </td>
                            <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@(r.Mensaje.Length > 80 ? r.Mensaje[..80] + "…" : r.Mensaje)</td>
                            <td class="text-end">@(r.Monto?.ToString("N2") ?? "-")</td>
                            <td class="text-center">@(r.Evidencias > 0 ? $"📎 {r.Evidencias}" : "-")</td>
                            <td class="text-center">
                                <div class="form-check d-inline-block">
                                    <input asp-for="Reportes[i].Eliminar" class="form-check-input" />
                                    <label asp-for="Reportes[i].Eliminar" class="form-check-label small">Desvincular</label>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Reportes.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted">Sin reportes asociados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    
    <div class="d-flex flex-wrap gap-2 mb-5">
        <button type="submit" name="accion" value="guardar" class="btn btn-primary btn-lg">Guardar expediente integral</button>
        @if (!esNuevo)
        {
            <a class="btn btn-outline-dark btn-lg" asp-action="Detalle" asp-route-id="@Model.Id">Generar carpeta fiscal</a>
        }
        <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Cancelar / volver al listado</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
