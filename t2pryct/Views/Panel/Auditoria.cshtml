@model List<AuditLog>
@{
    ViewData["Title"] = "Auditoría";
}

<h1 class="h3 mb-3">Bitácora de auditoría y trazabilidad</h1>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead class="table-light"><tr><th>Fecha y hora</th><th>Acción</th><th>Entidad</th><th>Detalle</th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr><td>@a.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@a.Accion</td><td>@a.Entidad @(a.EntidadId != null ? $"#{a.EntidadId}" : "")</td><td>@a.Detalle</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted">Sin registros.</td></tr> }
        </tbody>
    </table>
</div>
