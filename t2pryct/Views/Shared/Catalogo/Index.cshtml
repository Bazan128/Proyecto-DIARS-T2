@model IEnumerable<ICatalogo>
@{
    var titulo = (string)ViewData["Titulo"]!;
    var conProvincia = (bool)ViewData["TieneProvincia"]!;
    ViewData["Title"] = titulo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@titulo</h1>
    <a class="btn btn-primary" asp-action="Crear">+ Nuevo</a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light"><tr><th>Nombre</th>@if (conProvincia) { <th>Provincia</th> }<th>Estado</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                @if (conProvincia) { <td>@((item as Distrito)?.Provincia)</td> }
                <td><span class="badge bg-@(item.Activo ? "success" : "secondary")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@item.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este registro?');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
